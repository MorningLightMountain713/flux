[Unit]
Description=Inner Docker daemon (harness node, systemd mode)
After=network.target

[Service]
ExecStartPre=/bin/rm -f /var/run/docker.pid
ExecStart=/usr/bin/dockerd --data-root /mnt/appdata/docker
Restart=always
RestartSec=1
Delegate=yes
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
