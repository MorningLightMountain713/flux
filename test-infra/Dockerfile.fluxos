FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    sudo \
    ufw \
    mount \
    cron \
    gnupg \
    iproute2 \
    socat \
    iptables \
    e2fsprogs \
    systemd \
    xfsprogs \
    acl \
    dbus \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

# The mesh data plane: nebula + nebula-cert at the version FluxOS requires,
# fetched from the upstream release and verified against the pins the harness
# shares with the OS image (test-infra/mesh_bins.pins).
COPY test-infra/mesh_bins.pins /tmp/mesh_bins.pins
RUN . /tmp/mesh_bins.pins \
    && ARCH="$(dpkg --print-architecture)" \
    && case "$ARCH" in \
         amd64) NEBULA_SHA256="$NEBULA_SHA256_AMD64" ;; \
         arm64) NEBULA_SHA256="$NEBULA_SHA256_ARM64" ;; \
         *) echo "no pinned nebula checksum for architecture $ARCH" >&2; exit 1 ;; \
       esac \
    && curl -fsSL -o /tmp/nebula.tar.gz "https://github.com/slackhq/nebula/releases/download/${NEBULA_VERSION}/nebula-linux-${ARCH}.tar.gz" \
    && echo "${NEBULA_SHA256}  /tmp/nebula.tar.gz" | sha256sum --check --status \
    && tar -xzf /tmp/nebula.tar.gz -C /usr/bin nebula nebula-cert \
    && rm /tmp/nebula.tar.gz /tmp/mesh_bins.pins

RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce docker-ce-cli containerd.io \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /flux

COPY package.json ./
# package.json declares @runonflux/flux-spec* as file:../flux-spec/packages/*
# (the same sibling-checkout layout the test nodes use). npm creates those
# links without verifying the target, so a missing /flux-spec surfaces only at
# runtime as "Cannot find module". Provide a flux-spec checkout at the repo
# root (gitignored) before building.
COPY flux-spec /flux-spec
# The file: deps are symlinks, and Node resolves their imports from the REAL
# path (/flux-spec/...), never reaching /flux/node_modules - flux-spec needs
# its own workspace install, same as the sibling checkout has on a dev box.
RUN cd /flux-spec && npm install --omit=dev
RUN npm install --production

COPY . .

COPY test-infra/fixtures/userconfig-template.js /flux/config/userconfig.js

# Pre-bake CloudUI: boot awaits checkAndUpdateCloudUI, and a missing folder makes
# every container shell out to real GitHub (scripts/update-cloudui.sh bypasses the
# stubbed release API). With content + a version file present, the check goes to
# the stub, 404s, and boot proceeds without leaving the harness network.
RUN mkdir -p /flux/CloudUI \
    && echo '<!doctype html><title>CloudUI harness placeholder</title>' > /flux/CloudUI/index.html \
    && echo 'harness-prebaked' > /flux/CloudUI/version

RUN ln -s /flux /root/zelflux

ENV NODE_CONFIG_DIR=/flux/ZelBack/config

COPY test-infra/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 16126 16127 16128 16129

ENTRYPOINT ["/entrypoint.sh"]
CMD ["node", "app.js"]
